# The public Render service leaves this disabled. Turn it on only on the
# computer where your local model server is running.
SUNFINDER_ASSISTANT_ENABLED=true
# ollama is the default. Set this to vllm only after starting the two local
# vLLM services described in the README.
SUNFINDER_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
SUNFINDER_CHAT_MODEL=qwen3:8b
SUNFINDER_EMBEDDING_MODEL=qwen3-embedding:0.6b
SUNFINDER_ASSISTANT_TIMEOUT_SECONDS=45

# vLLM uses separate OpenAI-compatible servers for chat and embeddings.
# Uncomment these when SUNFINDER_LLM_PROVIDER=vllm.
# SUNFINDER_VLLM_CHAT_BASE_URL=http://127.0.0.1:8000/v1
# SUNFINDER_VLLM_EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
# SUNFINDER_VLLM_API_KEY=sunfinder-local
# The 4-bit 8B model fits on a 16 GB NVIDIA GPU. The launcher also reserves
# room for the separate embedding server.
# SUNFINDER_VLLM_CHAT_MODEL=Qwen/Qwen3-8B-AWQ
# SUNFINDER_VLLM_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# SUNFINDER_VLLM_CHAT_MAX_MODEL_LEN=8192
# SUNFINDER_VLLM_CHAT_GPU_MEMORY_UTILIZATION=0.72
# SUNFINDER_VLLM_EMBEDDING_MAX_MODEL_LEN=2048
# SUNFINDER_VLLM_EMBEDDING_GPU_MEMORY_UTILIZATION=0.14
